[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/skirmish_status_row.gd" id="1_row"]
[ext_resource type="StyleBox" path="res://prefabs/styles/health_bar_bg.tres" id="2_bg"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_row"]
resource_local_to_scene = true
bg_color = Color(0.6, 0.6, 0.6, 0)

[node name="SkirmishStatusRow" type="PanelContainer"]
theme_override_styles/panel = SubResource("StyleBoxFlat_row")
script = ExtResource("1_row")

[node name="HBox" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="NameLabel" type="Label" parent="HBox"]
custom_minimum_size = Vector2(150, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "Name"

[node name="HealthBar" type="ProgressBar" parent="HBox"]
custom_minimum_size = Vector2(180, 16)
layout_mode = 2
size_flags_horizontal = 3
theme_override_styles/background = ExtResource("2_bg")
show_percentage = false
